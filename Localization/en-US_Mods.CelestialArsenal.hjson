Items: {
	CometSword: {
		DisplayName: Comet Sword
		Tooltip:
			'''
			Benefits from both melee and magic bonuses
			Calls down a comet from the sky
			Can be upgraded in Hardmode with 12 Soul of Light and 2 Unicorn Horn
			'''
	}

	CometSwordPhase2: {
		DisplayName: Comet Sword Awakened
		Tooltip:
			'''
			Benefits from both melee and magic bonuses
			Calls down two comets from the sky
			Hold right click to charge a giant meteor
			The meteor falls automatically once fully charged
			'''
	}
}

Projectiles: {
	CometProjectile: {
		DisplayName: Comet
	}

	CometChargeProjectile: {
		DisplayName: Comet Charge
	}
}

DamageClasses: {
	MeleeMagicDamageClass: {
		DisplayName: melee/magic damage
	}
}

Buffs: {
	CometCooldownBuff: {
		DisplayName: Comet Recharge
		Description: The sword is recharging its giant meteor
	}
}

Common: {
	CometMana: Each comet uses {0} mana
	BigCometMana: Giant meteor uses {0} mana
	BigCometCooldown: Giant meteor cooldown: {0} seconds
}

Configs: {
	CelestialArsenalConfig: {
		DisplayName: Celestial Arsenal
		ChargeTimeSeconds: {
			Label: Charge time (seconds)
			Tooltip: How long right click must be held to charge the giant meteor
		}
		BigCometDamageMultiplier: {
			Label: Giant meteor damage multiplier
			Tooltip: Giant meteor damage compared to the sword's normal damage
		}
		ExplosionSize: {
			Label: Giant meteor explosion size
			Tooltip: Width and height of the giant meteor explosion in pixels
		}
		CometManaCost: {
			Label: Mana per comet
			Tooltip: Mana used by each comet from left click. 0 means free
		}
		BigCometManaCost: {
			Label: Mana per giant meteor
			Tooltip: Mana used when the giant meteor is released. 0 means free
		}
		RightClickCooldownSeconds: {
			Label: Giant meteor cooldown (seconds)
			Tooltip: Cooldown after a giant meteor is released. 0 means no cooldown
		}
	}

	CelestialArsenalClientConfig: {
		DisplayName: Celestial Arsenal (Client)
		ScreenShake: {
			Label: Screen shake
			Tooltip: Turn off to remove all screen shake from this mod
		}
		ScreenShakeIntensity: {
			Label: Screen shake intensity
			Tooltip: Lower this to make the shake weaker
		}
	}
}
